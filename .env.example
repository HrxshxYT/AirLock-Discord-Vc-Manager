# Copy this file to ".env" and fill in your bot token.
# https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=your-bot-token-here

# OPTIONAL: a server ID for INSTANT slash-command registration (global sync can
# take ~1 hour). Leave BLANK for a public bot. Enable Developer Mode in Discord,
# then right-click your server icon -> "Copy Server ID".
GUILD_ID=
